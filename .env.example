# String de conexão do Banco de Dados SQL (PostgreSQL - Render Postgres, Neon.tech ou Supabase)
# Exemplo: postgresql://usuario:senha@host.oregon-postgres.render.com/bv_tasks?sslmode=require
DATABASE_URL=

# Porta do servidor Full Stack (o Render injeta automaticamente em produção)
PORT=4173

# Opcional: Google Client ID oficial para login One-Tap (GSI)
VITE_GOOGLE_CLIENT_ID=

# Chave da API do Google Gemini para o Fechamento Inteligente do Mês (gemini-2.5-flash)
GEMINI_API_KEY=
